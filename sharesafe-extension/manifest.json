{
  "manifest_version": 3,
  "name": "ShareSafe — PII & Privacy Guard",
  "version": "1.0.0",
  "description": "Defensive privacy scanner that detects sensitive PII, credentials, and identity leaks on webpages and drafts before sharing.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ShareSafe Privacy Scanner"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "optional_host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*"
  ]
}
