{
  "manifest_version": 3,
  "name": "ShareSafe - PII & Privacy Guard",
  "version": "1.2.0",
  "description": "Defensive privacy scanner that detects sensitive PII, credentials, and identity leaks on webpages, drafts, messaging, and automated file uploads before sharing.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ShareSafe Privacy Scanner"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://mail.google.com/*",
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/file-shield.js", "content/gmail-adapter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/file-shield.js", "content/whatsapp-adapter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/selection-helper.js"],
      "run_at": "document_idle"
    }
  ]
}
