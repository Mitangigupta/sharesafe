# ShareSafe Environment Variables
SECRET_KEY=sharesafe-production-secure-key-replace-in-prod
FLASK_ENV=development
FLASK_PORT=5000

# Optional: Path to Tesseract OCR executable if not in system PATH
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
TESSERACT_CMD=
